---
import Icon from './icons/Icon.astro';

interface Props {
  href?: string;
  label?: string;
  class?: string;
  rel?: string;
  'aria-label'?: string;
  'data-plan'?: string;
  'data-checkout-buy'?: boolean;
  /** Opens the three-product chooser instead of navigating immediately. */
  choose?: boolean;
  size?: 'md' | 'lg';
  tone?: 'checkout' | 'primary';
}

const {
  href = '#',
  label = 'Buy now',
  class: className,
  rel,
  'aria-label': ariaLabel,
  'data-plan': dataPlan,
  'data-checkout-buy': dataCheckoutBuy,
  choose = false,
  size = 'md',
} = Astro.props;

const iconSize = size === 'lg' ? 20 : 18;
---

{
  choose ? (
    <button
      type="button"
      class:list={['buy-now-cta', size === 'lg' && 'buy-now-cta--lg', className]}
      aria-label={ariaLabel ?? label}
      data-checkout-choose
      data-plan={dataPlan}
    >
      <span class="buy-now-cta__label">{label}</span>
      <span class="buy-now-cta__icon" aria-hidden="true">
        <Icon name="arrowRight" size={iconSize} />
      </span>
    </button>
  ) : (
    <a
      href={href}
      rel={rel}
      aria-label={ariaLabel ?? label}
      class:list={['buy-now-cta', size === 'lg' && 'buy-now-cta--lg', className]}
      data-plan={dataPlan}
      {...(dataCheckoutBuy ? { 'data-checkout-buy': '' } : {})}
    >
      <span class="buy-now-cta__label">{label}</span>
      <span class="buy-now-cta__icon" aria-hidden="true">
        <Icon name="arrowRight" size={iconSize} />
      </span>
    </a>
  )
}
