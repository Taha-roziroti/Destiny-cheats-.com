---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import BuyNowButton from './BuyNowButton.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import {
  AFFILIATE_LINK_PLACEHOLDER,
  extractImageAltSuggestions,
  parseExactArticle,
  parseExactFrontmatter,
  resolveAffiliateHrefForSlug,
  resolveExternalAffiliateHrefForSlug,
} from '../lib/exactPageContent';
import { AFFILIATE_REL } from '../config/affiliate';
import { canonicalUrl } from '../config/seo';
import ShareButtons from './ShareButtons.astro';
import { t } from '../i18n';
import type { BreadcrumbItem } from '../utils/schema';
import { HERO_IMAGE_SIZES, HERO_IMAGE_WIDTHS } from '../utils/responsiveImage';

interface Shot {
  src: string;
  alt: string;
}

interface Props {
  raw: string;
  crumbs: BreadcrumbItem[];
  shots: Shot[];
  ogImage: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article';
  columns?: 2 | 3;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  /** When true, hero Buy opens the three-product chooser (homepage / general CTAs). */
  chooseCheckout?: boolean;
  secondaryCta?: { href: string; label: string };
  buyLabel?: string;
  buyAriaLabel?: string;
}

const {
  raw,
  crumbs,
  shots,
  ogImage,
  jsonLd,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  chooseCheckout = false,
  secondaryCta,
  buyLabel = 'Buy now',
  buyAriaLabel,
} = Astro.props;
const fm = parseExactFrontmatter(raw);
const alts = extractImageAltSuggestions(raw);
const pageSlug = fm.slug || Astro.url.pathname;
const checkoutHref = resolveAffiliateHrefForSlug(pageSlug);
const externalCheckoutHref = resolveExternalAffiliateHrefForSlug(pageSlug);
const checkoutPlan = checkoutHref.includes('cloud-dma')
  ? 'cloud-dma'
  : checkoutHref.includes('hwid')
    ? 'hwid-spoofer'
    : 'fragpunk';
const article = parseExactArticle(raw);
const shareUrl = canonicalUrl(pageSlug.endsWith('/') || pageSlug === '/' ? pageSlug : `${pageSlug}/`);
const resolvedSecondary =
  secondaryCta ??
  (fm.slug.includes('cloud-dma-requirements')
    ? { href: '/cloud-dma/', label: 'Cloud DMA overview' }
    : fm.slug.includes('cloud-dma')
      ? { href: '/cloud-dma-requirements/', label: 'System requirements' }
      : fm.slug.includes('fragpunk-cheats-price')
        ? { href: '/cloud-dma/', label: 'Cloud DMA details' }
        : { href: '/fragpunk-cheats-price/', label: 'See pricing' });
const resolvedBuyAria =
  buyAriaLabel ??
  (checkoutPlan === 'cloud-dma'
    ? 'Buy Cloud DMA'
    : checkoutPlan === 'hwid-spoofer'
      ? 'Buy HWID Spoofer'
      : 'Buy FragPunk cheats');

const galleryShots = shots.map((shot, i) => ({
  src: shot.src,
  alt: alts[i] ?? shot.alt,
}));

const heroShot = galleryShots[0];
const inlineShots = galleryShots.slice(1);

const affiliateAttrs = `href="${externalCheckoutHref}" rel="${AFFILIATE_REL}" target="_blank" data-checkout-buy data-plan="${checkoutPlan}"`;

const leadHtml = article.leadHtml.replaceAll(
  `href="${AFFILIATE_LINK_PLACEHOLDER}"`,
  affiliateAttrs,
);

const sections = article.sections.map((section) => ({
  ...section,
  html: section.html.replaceAll(
    `href="${AFFILIATE_LINK_PLACEHOLDER}"`,
    affiliateAttrs,
  ),
  hasTable: section.html.includes('<table'),
}));

const heroTitle = article.h1 || fm.title;
const heroLead = article.leadText || fm.description;
---

<BaseLayout
  title={fm.title}
  description={fm.description}
  ogImage={ogImage}
  ogImageAlt={heroShot?.alt ?? fm.title}
  ogType={ogType}
  articlePublishedTime={articlePublishedTime}
  articleModifiedTime={articleModifiedTime}
  jsonLd={jsonLd}
>
  <section class="exact-hero relative isolate min-h-[min(92vh,52rem)] overflow-hidden" aria-labelledby="exact-hero-title">
    {heroShot ? (
      <div class="exact-hero__media absolute inset-0" aria-hidden="true">
        <ResponsiveImage
          src={heroShot.src}
          alt={heroShot.alt}
          width={1920}
          height={1080}
          widths={[640, 960, 1200, 1600]}
          sizes="100vw"
          loading="eager"
          fetchPriority="high"
          class="exact-hero__img h-full w-full object-cover"
        />
      </div>
    ) : (
      <div class="exact-hero__fallback absolute inset-0" aria-hidden="true" />
    )}
    <div class="exact-hero__veil absolute inset-0" aria-hidden="true" />

    <div class="relative z-10 mx-auto flex min-h-[min(92vh,52rem)] max-w-6xl flex-col justify-end px-5 pb-14 pt-28 md:pb-20 md:pt-36">
      {crumbs.length > 1 && (
        <div class="exact-hero__crumbs mb-6 max-w-xl">
          <Breadcrumbs items={crumbs} />
        </div>
      )}

      <p class="exact-hero__brand mb-4 font-[family-name:var(--font-heading)] text-sm font-bold uppercase tracking-[0.22em] text-white/90 md:text-base">
        {t.site.name}
      </p>
      <h1
        id="exact-hero-title"
        class="exact-hero__title max-w-3xl font-[family-name:var(--font-heading)] text-4xl font-bold tracking-tight text-white drop-shadow-[0_2px_24px_rgba(0,0,0,0.55)] sm:text-5xl md:text-6xl"
      >
        {heroTitle}
      </h1>
      {heroLead && (
        <p class="exact-hero__lead mt-5 max-w-xl text-base leading-relaxed text-white/88 md:text-lg">
          {heroLead}
        </p>
      )}
      <div class="exact-hero__cta mt-8 flex flex-wrap items-center gap-3">
        <BuyNowButton
          href={chooseCheckout ? '#' : checkoutHref}
          rel={chooseCheckout ? undefined : AFFILIATE_REL}
          data-plan={chooseCheckout ? 'chooser' : checkoutPlan}
          data-checkout-buy={!chooseCheckout}
          choose={chooseCheckout}
          label={buyLabel}
          size="lg"
          aria-label={resolvedBuyAria}
        />
        <a
          href={resolvedSecondary.href}
          class="exact-hero__secondary inline-flex items-center justify-center rounded-xl border border-white/35 bg-white/10 px-5 py-3 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/18"
        >
          {resolvedSecondary.label}
        </a>
      </div>
    </div>
  </section>

  <div class="exact-body relative border-t border-border/50 bg-background">
    {leadHtml && (
      <section class="mx-auto max-w-3xl px-5 py-10 md:py-14">
        <div class="exact-copy prose-bodycam text-foreground" set:html={leadHtml} />
      </section>
    )}

    {sections.map((section, i) => {
      const shot = inlineShots[i];
      const reverse = i % 2 === 1;
      const pairWithImage = Boolean(shot) && !section.hasTable;

      return (
        <section
          class:list={[
            'exact-section border-t border-border/40',
            pairWithImage ? 'exact-section--split' : 'exact-section--stack',
          ]}
        >
          <div
            class:list={[
              'mx-auto grid max-w-6xl items-center gap-8 px-5 py-12 md:gap-12 md:py-16',
              pairWithImage ? 'lg:grid-cols-2' : '',
              pairWithImage && reverse ? 'lg:[&>*:first-child]:order-2' : '',
            ]}
          >
            <div class="exact-copy prose-bodycam min-w-0 text-foreground">
              <h2>{section.heading}</h2>
              <div set:html={section.html} />
            </div>

            {shot && (
              <figure
                class:list={[
                  'exact-section__media m-0 overflow-hidden',
                  section.hasTable ? 'lg:col-span-1 max-w-3xl' : '',
                ]}
              >
                <ResponsiveImage
                  src={shot.src}
                  alt={shot.alt}
                  width={1024}
                  height={646}
                  widths={HERO_IMAGE_WIDTHS}
                  sizes={pairWithImage ? '(min-width: 1024px) 28rem, 100vw' : HERO_IMAGE_SIZES}
                  class="exact-section__img h-auto w-full object-contain"
                  loading="lazy"
                />
              </figure>
            )}
          </div>
        </section>
      );
    })}

    <div class="mx-auto max-w-3xl px-5 pb-14">
      <ShareButtons shareUrl={shareUrl} shareText={fm.title} />
    </div>
  </div>
</BaseLayout>

<style>
  .exact-hero__fallback {
    background:
      radial-gradient(ellipse 80% 60% at 50% 20%, color-mix(in oklab, var(--color-primary) 35%, transparent), transparent 70%),
      linear-gradient(160deg, #0a0c10 0%, #141820 45%, #0a0c10 100%);
  }

  .exact-hero__veil {
    /* Stronger left/bottom scrim so copy stays readable on bright neon hero art */
    background:
      linear-gradient(180deg, rgba(6, 8, 12, 0.42) 0%, rgba(6, 8, 12, 0.28) 38%, rgba(6, 8, 12, 0.82) 72%, var(--color-background) 100%),
      linear-gradient(90deg, rgba(6, 8, 12, 0.88) 0%, rgba(6, 8, 12, 0.55) 38%, rgba(6, 8, 12, 0.22) 68%, rgba(6, 8, 12, 0.35) 100%);
  }

  .exact-hero__brand {
    animation: exact-hero-rise 700ms ease-out both;
  }

  .exact-hero__title {
    animation: exact-hero-rise 850ms ease-out 80ms both;
    text-wrap: balance;
  }

  .exact-hero__lead {
    animation: exact-hero-rise 900ms ease-out 140ms both;
  }

  .exact-hero__cta {
    animation: exact-hero-rise 950ms ease-out 200ms both;
  }

  .exact-hero__img {
    /* Keep character art toward the right; leave left open for headline/CTA */
    object-position: 78% center;
    transform: scale(1.04);
    animation: exact-hero-drift 18s ease-in-out infinite alternate;
  }

  @keyframes exact-hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes exact-hero-drift {
    from {
      transform: scale(1.04) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.08) translate3d(-1.2%, -0.8%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exact-hero__brand,
    .exact-hero__title,
    .exact-hero__lead,
    .exact-hero__cta,
    .exact-hero__img {
      animation: none;
    }

    .exact-hero__img {
      transform: none;
    }
  }

  .exact-section__media {
    border: 1px solid color-mix(in oklab, var(--color-border) 80%, transparent);
    background: color-mix(in oklab, var(--color-muted) 25%, transparent);
  }

  .exact-section__img {
    /* Preserve native menu screenshot aspect — never stretch */
    aspect-ratio: 1024 / 646;
    background: #0a0a0a;
  }

  .exact-copy :global(h2) {
    margin: 0 0 0.85rem;
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .exact-copy :global(h3) {
    margin: 1.5rem 0 0.65rem;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .exact-copy :global(p),
  .exact-copy :global(li) {
    color: var(--color-muted-foreground);
    line-height: 1.7;
  }

  .exact-copy :global(p) {
    margin: 0.85rem 0;
  }

  .exact-copy :global(p:first-child) {
    margin-top: 0;
  }

  .exact-copy :global(ul),
  .exact-copy :global(ol) {
    margin: 0.75rem 0;
    padding-left: 1.25rem;
  }

  .exact-copy :global(ul) {
    list-style: disc;
  }

  .exact-copy :global(ol) {
    list-style: decimal;
  }

  .exact-copy :global(a) {
    color: var(--color-primary);
    text-underline-offset: 3px;
  }

  .exact-copy :global(a:hover) {
    text-decoration: underline;
  }

  .exact-copy :global(table) {
    width: 100%;
    margin: 1.25rem 0;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .exact-copy :global(th),
  .exact-copy :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.65rem 0.75rem;
    text-align: left;
  }

  .exact-copy :global(th) {
    background: color-mix(in oklab, var(--color-muted) 40%, transparent);
    font-weight: 600;
    color: var(--color-foreground);
  }

  .exact-copy :global(td) {
    color: var(--color-muted-foreground);
  }
</style>
