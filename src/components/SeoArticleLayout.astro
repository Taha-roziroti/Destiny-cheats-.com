---
import Breadcrumbs from './Breadcrumbs.astro';
import BuyNowButton from './BuyNowButton.astro';
import { PRIMARY_CHECKOUT_PATH } from '../config/checkout';
import { AFFILIATE_REL } from '../config/affiliate';
import { Button } from '@/components/starwind/button';

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  h1: string;
  lead: string;
  crumbs: Crumb[];
  showBuyCta?: boolean;
  secondaryCtaHref?: string;
  secondaryCtaLabel?: string;
}

const {
  h1,
  lead,
  crumbs,
  showBuyCta = true,
  secondaryCtaHref,
  secondaryCtaLabel,
} = Astro.props;
---

<section class="border-b border-border/60 bg-gradient-to-b from-muted/40 via-background to-background">
  <div class="mx-auto max-w-6xl px-5 pb-10 pt-28 md:pb-14 md:pt-32">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-6 max-w-4xl font-[family-name:var(--font-heading)] text-3xl font-bold tracking-tight text-foreground sm:text-4xl md:text-5xl">
      {h1}
    </h1>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-muted-foreground md:text-lg">
      {lead}
    </p>
    {(showBuyCta || secondaryCtaHref) && (
      <div class="mt-8 flex flex-wrap gap-3">
        {showBuyCta && (
          <BuyNowButton
            href={PRIMARY_CHECKOUT_PATH}
            rel={AFFILIATE_REL}
            label="Buy now"
            aria-label="Buy Product Alpha at checkout"
          />
        )}
        {secondaryCtaHref && secondaryCtaLabel && (
          <Button as="a" href={secondaryCtaHref} variant="outline" class="rounded-xl">
            {secondaryCtaLabel}
          </Button>
        )}
      </div>
    )}
  </div>
</section>

<div class="mx-auto max-w-6xl px-5 py-10 md:py-14">
  <article class="prose-bodycam mx-auto max-w-3xl space-y-10 text-foreground">
    <slot />
  </article>
  <div class="mx-auto mt-12 max-w-3xl">
    <slot name="after" />
  </div>
</div>

<style>
  .prose-bodycam :global(h2) {
    margin-top: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .prose-bodycam :global(h3) {
    margin-top: 1.25rem;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .prose-bodycam :global(p),
  .prose-bodycam :global(li) {
    color: var(--color-muted-foreground);
    line-height: 1.7;
  }
  .prose-bodycam :global(ul) {
    margin: 0.75rem 0 0;
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-bodycam :global(a) {
    color: var(--color-primary);
    text-underline-offset: 3px;
  }
  .prose-bodycam :global(a:hover) {
    text-decoration: underline;
  }
</style>
