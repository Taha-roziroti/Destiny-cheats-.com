---
import ExactContentPage from '../components/ExactContentPage.astro';
import raw from '../../content/pages/destiny-2-cheat-setup.md?raw';
import { DESTINY_PRODUCT_IMAGES, SEO_MEDIA } from '../config/media';
import { articleSchema, breadcrumbSchema, faqPageSchema } from '../utils/schema';
import { parseExactArticle, parseExactFrontmatter } from '../lib/exactPageContent';

const path = '/destiny-2-cheat-setup/';
const fm = parseExactFrontmatter(raw);
const article = parseExactArticle(raw);
const published = '2026-11-25';
const crumbs = [
  { name: 'Destiny 2 setup hub', path: '/' },
  { name: 'Setup', path },
];
const faqs = [
  {
    num: '01',
    q: 'How do I install Destiny 2 cheats?',
    a: 'Pay on the live listing, open the merchant portal from your receipt, then follow the current installer notes for your Windows edition and Cloud DMA path.',
  },
  {
    num: '02',
    q: 'What if Hyper-V will not enable?',
    a: 'Stop and fix firmware virtualization / Windows edition issues first. Cloud DMA cannot proceed without Hyper-V availability.',
  },
];
---

<ExactContentPage
  raw={raw}
  ogType="article"
  articlePublishedTime={published}
  crumbs={crumbs}
  ogImage={SEO_MEDIA.heroPoster}
  columns={2}
  chooseCheckout={true}
  secondaryCta={{ href: '/destiny-2-cheat-system-requirements/', label: 'Open compatibility checklist' }}
  buyLabel="Buy now"
  buyAriaLabel="Choose a Destiny 2 product to buy"
  shots={[
    {
      src: DESTINY_PRODUCT_IMAGES.menuAimbot.src,
      alt: 'Destiny 2 product activation interface',
    },
    {
      src: DESTINY_PRODUCT_IMAGES.menuMisc.src,
      alt: 'Destiny 2 software setup screen',
    },
  ]}
  jsonLd={[
    articleSchema({
      name: fm.title,
      headline: article.h1 || fm.title,
      description: fm.description,
      url: path,
      image: SEO_MEDIA.heroPoster,
      datePublished: published,
      type: 'TechArticle',
    }),
    faqPageSchema(faqs),
    breadcrumbSchema(crumbs),
  ]}
/>
