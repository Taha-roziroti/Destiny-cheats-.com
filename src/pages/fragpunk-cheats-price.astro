---
import ExactContentPage from '../components/ExactContentPage.astro';
import raw from '../../content/pages/fragpunk-cheats-price.md?raw';
import { FRAGPUNK_PRODUCT_IMAGES, SEO_MEDIA } from '../config/media';
import { articleSchema, breadcrumbSchema } from '../utils/schema';
import { parseExactArticle, parseExactFrontmatter } from '../lib/exactPageContent';

const path = '/fragpunk-cheats-price/';
const fm = parseExactFrontmatter(raw);
const article = parseExactArticle(raw);
const published = '2026-11-25';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'FragPunk Pricing', path },
];
---

<ExactContentPage
  raw={raw}
  ogType="article"
  articlePublishedTime={published}
  crumbs={crumbs}
  ogImage={SEO_MEDIA.heroPoster}
  columns={2}
  secondaryCta={{ href: '/cloud-dma/', label: 'Cloud DMA details' }}
  buyLabel="Buy FragPunk"
  buyAriaLabel="Buy FragPunk cheats"
  shots={[
    FRAGPUNK_PRODUCT_IMAGES.heroArt,
    FRAGPUNK_PRODUCT_IMAGES.menuVisuals,
  ]}
  jsonLd={[
    articleSchema({
      name: fm.title,
      headline: article.h1 || fm.title,
      description: fm.description,
      url: path,
      image: SEO_MEDIA.heroPoster,
      datePublished: published,
      type: 'Article',
    }),
    breadcrumbSchema(crumbs),
  ]}
/>
