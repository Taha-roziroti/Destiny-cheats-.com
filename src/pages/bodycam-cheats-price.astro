---
import ExactContentPage from '../components/ExactContentPage.astro';
import raw from '../../content/pages/bodycam-cheats-price.md?raw';
import { BODYCAM_PRODUCT_IMAGES, SEO_MEDIA } from '../config/media';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';
import { parseExactFrontmatter } from '../lib/exactPageContent';

const path = '/bodycam-cheats-price/';
const fm = parseExactFrontmatter(raw);
---

<ExactContentPage
  raw={raw}
  crumbs={[
    { name: 'Home', path: '/' },
    { name: 'Pricing', path },
  ]}
  ogImage={SEO_MEDIA.nightRaid}
  shots={[
    BODYCAM_PRODUCT_IMAGES.hallwayFlashlight,
    BODYCAM_PRODUCT_IMAGES.espBoxWarehouse,
    BODYCAM_PRODUCT_IMAGES.menuTactical,
  ]}
  jsonLd={[
    webPageSchema({ name: fm.title, description: fm.description, url: path }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Bodycam Cheats Price', path },
    ]),
  ]}
/>
