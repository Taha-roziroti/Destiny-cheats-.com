---
import ExactContentPage from '../components/ExactContentPage.astro';
import raw from '../../content/pages/destiny-2-cheat-ban-policy.md?raw';
import { DESTINY_PRODUCT_IMAGES, SEO_MEDIA } from '../config/media';
import { articleSchema, breadcrumbSchema, faqPageSchema } from '../utils/schema';
import { parseExactArticle, parseExactFrontmatter } from '../lib/exactPageContent';

const path = '/destiny-2-cheat-ban-policy/';
const fm = parseExactFrontmatter(raw);
const article = parseExactArticle(raw);
const published = '2026-11-25';
const crumbs = [
  { name: 'Destiny 2 policy hub', path: '/' },
  { name: 'Ban policy', path },
];
const faqs = [
  {
    num: '01',
    q: 'Are Destiny 2 cheats allowed?',
    a: 'Bungie’s published rules prohibit unauthorized cheats. Using them can result in penalties.',
  },
  {
    num: '02',
    q: 'Can a merchant promise you will not be banned?',
    a: 'No trustworthy merchant can promise that. Listings describe features and access terms—not immunity from platform enforcement.',
  },
];
---

<ExactContentPage
  raw={raw}
  ogType="article"
  articlePublishedTime={published}
  crumbs={crumbs}
  ogImage={SEO_MEDIA.heroPoster}
  columns={2}
  chooseCheckout={true}
  secondaryCta={{ href: '/destiny-2-cheats-review/', label: 'Open feature review' }}
  buyLabel="Buy now"
  buyAriaLabel="Choose a Destiny 2 product to buy"
  shots={[
    {
      src: DESTINY_PRODUCT_IMAGES.heroArt.src,
      alt: 'Bungie Destiny 2 published account restrictions information',
    },
  ]}
  jsonLd={[
    articleSchema({
      name: fm.title,
      headline: article.h1 || fm.title,
      description: fm.description,
      url: path,
      image: SEO_MEDIA.heroPoster,
      datePublished: published,
      type: 'Article',
    }),
    faqPageSchema(faqs),
    breadcrumbSchema(crumbs),
  ]}
/>
