---
import ExactContentPage from '../components/ExactContentPage.astro';
import raw from '../../content/pages/bodycam-cloud-dma.md?raw';
import { BODYCAM_PRODUCT_IMAGES, SEO_MEDIA } from '../config/media';
import { articleSchema, breadcrumbSchema } from '../utils/schema';
import { parseExactFrontmatter } from '../lib/exactPageContent';

const path = '/bodycam-cloud-dma/';
const fm = parseExactFrontmatter(raw);
const published = '2026-11-24';
---

<ExactContentPage
  raw={raw}
  ogType="article"
  crumbs={[
    { name: 'Home', path: '/' },
    { name: 'Cloud DMA', path },
  ]}
  ogImage={SEO_MEDIA.dmaSetup}
  columns={2}
  shots={[
    BODYCAM_PRODUCT_IMAGES.scopeEsp,
    BODYCAM_PRODUCT_IMAGES.menuTactical,
    BODYCAM_PRODUCT_IMAGES.hallwayFlashlight,
    BODYCAM_PRODUCT_IMAGES.espSnaplinesRadar,
  ]}
  jsonLd={[
    articleSchema({
      name: fm.title,
      headline: 'Bodycam Cloud DMA: What It Is and What You Need',
      description: fm.description,
      url: path,
      image: SEO_MEDIA.dmaSetup,
      datePublished: published,
      type: 'Article',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Bodycam Cloud DMA', path },
    ]),
  ]}
/>
