---
import ExactContentPage from '../components/ExactContentPage.astro';
import raw from '../../content/pages/cloud-dma-for-destiny-2.md?raw';
import { DESTINY_PRODUCT_IMAGES, SEO_MEDIA } from '../config/media';
import { getCloudDmaOfferForSchema } from '../data/productPricing';
import { breadcrumbSchema, faqPageSchema, productSchema } from '../utils/schema';
import { parseExactFrontmatter } from '../lib/exactPageContent';

const path = '/cloud-dma-for-destiny-2/';
const fm = parseExactFrontmatter(raw);
const crumbs = [
  { name: 'Destiny 2 product hub', path: '/' },
  { name: 'Cloud DMA', path },
];
const faqs = [
  {
    num: '01',
    q: 'Is Cloud DMA included with Destiny 2 cheats?',
    a: 'No. Cloud DMA is a separate $50 lifetime listing with additional required services.',
  },
  {
    num: '02',
    q: 'Do I need a second PC for Cloud DMA?',
    a: 'The listing describes a single-PC Hyper-V setup, not a second tower with external DMA hardware.',
  },
];
---

<ExactContentPage
  raw={raw}
  crumbs={crumbs}
  ogImage={SEO_MEDIA.dmaSetup}
  columns={2}
  secondaryCta={{ href: '/destiny-2-cheat-system-requirements/', label: 'Open PC checklist' }}
  buyLabel="Buy Cloud DMA"
  buyAriaLabel="Buy Cloud DMA"
  shots={[
    {
      src: DESTINY_PRODUCT_IMAGES.menuMisc.src,
      alt: 'Cloud DMA Hyper-V configuration interface',
    },
    {
      src: DESTINY_PRODUCT_IMAGES.gameplayScope.src,
      alt: 'Cloud DMA for Destiny 2 single-PC setup',
    },
  ]}
  jsonLd={[
    productSchema({
      name: 'Cloud DMA for Destiny 2',
      description: fm.description,
      url: path,
      offerPagePath: path,
      image: SEO_MEDIA.dmaSetup,
      sku: 'cloud-dma-destiny-2',
      offers: getCloudDmaOfferForSchema(path),
    }),
    faqPageSchema(faqs),
    breadcrumbSchema(crumbs),
  ]}
/>
