---
import ExactContentPage from '../components/ExactContentPage.astro';
import raw from '../../content/pages/bodycam-aimbot.md?raw';
import { BODYCAM_PRODUCT_IMAGES, SEO_MEDIA } from '../config/media';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';
import { parseExactFrontmatter } from '../lib/exactPageContent';

const path = '/bodycam-aimbot/';
const fm = parseExactFrontmatter(raw);
---

<ExactContentPage
  raw={raw}
  crumbs={[
    { name: 'Home', path: '/' },
    { name: 'Bodycam Aimbot', path },
  ]}
  ogImage={SEO_MEDIA.aimbotHud}
  shots={[
    BODYCAM_PRODUCT_IMAGES.aimbotForest,
    BODYCAM_PRODUCT_IMAGES.espSkeletonFov,
    BODYCAM_PRODUCT_IMAGES.scopeEsp,
  ]}
  jsonLd={[
    webPageSchema({ name: fm.title, description: fm.description, url: path }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Bodycam Aimbot', path },
    ]),
  ]}
/>
