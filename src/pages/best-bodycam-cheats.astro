---
import ExactContentPage from '../components/ExactContentPage.astro';
import raw from '../../content/pages/best-bodycam-cheats.md?raw';
import { BODYCAM_PRODUCT_IMAGES, SEO_MEDIA } from '../config/media';
import { articleSchema, breadcrumbSchema } from '../utils/schema';
import { parseExactFrontmatter } from '../lib/exactPageContent';

const path = '/best-bodycam-cheats/';
const fm = parseExactFrontmatter(raw);
const published = '2026-11-24';
---

<ExactContentPage
  raw={raw}
  ogType="article"
  crumbs={[
    { name: 'Home', path: '/' },
    { name: 'Buying guide', path },
  ]}
  ogImage={SEO_MEDIA.chamsPreview}
  shots={[
    BODYCAM_PRODUCT_IMAGES.menuOverlay,
    BODYCAM_PRODUCT_IMAGES.espSkeletonFov,
    BODYCAM_PRODUCT_IMAGES.hallwayFlashlight,
  ]}
  jsonLd={[
    articleSchema({
      name: fm.title,
      headline: 'Best Bodycam Cheats: What to Check Before You Buy',
      description: fm.description,
      url: path,
      image: SEO_MEDIA.chamsPreview,
      datePublished: published,
      type: 'Article',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Best Bodycam Cheats', path },
    ]),
  ]}
/>
