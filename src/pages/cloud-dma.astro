---
import ExactContentPage from '../components/ExactContentPage.astro';
import raw from '../../content/pages/cloud-dma.md?raw';
import { FRAGPUNK_PRODUCT_IMAGES, SEO_MEDIA } from '../config/media';
import { getCloudDmaOfferForSchema } from '../data/productPricing';
import { breadcrumbSchema, productSchema } from '../utils/schema';
import { parseExactFrontmatter } from '../lib/exactPageContent';

const path = '/cloud-dma/';
const fm = parseExactFrontmatter(raw);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Cloud DMA', path },
];
---

<ExactContentPage
  raw={raw}
  crumbs={crumbs}
  ogImage={SEO_MEDIA.dmaSetup}
  columns={2}
  secondaryCta={{ href: '/cloud-dma-requirements/', label: 'System requirements' }}
  buyLabel="Buy Cloud DMA"
  buyAriaLabel="Buy Cloud DMA"
  shots={[
    FRAGPUNK_PRODUCT_IMAGES.heroArt,
    FRAGPUNK_PRODUCT_IMAGES.menuMisc,
  ]}
  jsonLd={[
    productSchema({
      name: 'Cloud DMA',
      description: fm.description,
      url: path,
      offerPagePath: path,
      image: SEO_MEDIA.dmaSetup,
      sku: 'cloud-dma',
      offers: getCloudDmaOfferForSchema(path),
    }),
    breadcrumbSchema(crumbs),
  ]}
/>
